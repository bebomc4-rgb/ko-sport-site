{
  "manifest_version": 3,
  "name": "رفيق المسنجر",
  "version": "0.2.1",
  "description": "بيرد على رسائلك الخاصة بمسنجر فيسبوك، والإعدادات والذكاء الاصطناعي بالمجيب الآلي على كمبيوترك.",
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://www.messenger.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/messages/*",
        "https://web.facebook.com/messages/*",
        "https://www.messenger.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "رفيق المسنجر"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}