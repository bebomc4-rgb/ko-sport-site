{
  "manifest_version": 3,
  "name": "رفيق المسنجر",
  "version": "0.1.0",
  "description": "بيرد على رسائلك الخاصة بمسنجر فيسبوك بالذكاء الاصطناعي، بالطريقة يلي بتحددها إنت.",
  "permissions": ["storage", "notifications"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://www.messenger.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.cloudflare.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.facebook.com/messages/*", "https://web.facebook.com/messages/*", "https://www.messenger.com/*"],
    "js": ["settings.js", "content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "رفيق المسنجر" },
  "options_page": "options.html",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
